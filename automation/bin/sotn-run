#!/usr/bin/env bash
# One entry point for every long-running SOTN harness process.
#
# WHY THIS EXISTS
#   Every one of these was previously a remembered incantation. The permuter in
#   particular defaults to ONE thread and never exits, so months of runs were
#   single-threaded and had to be killed by hand; twice they were reported
#   stopped while still running. Defaults belong in a file, not in a habit.
#
#   The `run-permuter`, `runfleet-cli`, `runfleet-llama` and `sotn-dash`
#   commands are symlinks to this script. It dispatches on $0, so adding a new
#   name means adding a symlink and a case, not a new copy of the argument
#   handling.
#
# SAFETY
#   set -euo pipefail, so a failed step stops the script instead of running the
#   next one against a half-built state. Every stop path is idempotent: running
#   `stop` twice is not an error and does not kill anything it did not start.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
cd "$REPO"

PY="${SOTN_PYTHON:-$REPO/.venv/bin/python}"
[ -x "$PY" ] || PY="$(command -v python3)"

# EXPORT it. commands_client builds the permuter argv with
# os.environ.get("SOTN_PYTHON", "python3"), so an unexported PY means the
# permuter runs under system python3 -- which has no pycparser, so every job
# dies instantly with ModuleNotFoundError and the supervisor reports
# "job ended (done), best None". Computing the right interpreter and then not
# passing it on is indistinguishable from not computing it at all.
export SOTN_PYTHON="$PY"

# commands_client fails CLOSED: with SOTN_CMD_DRYRUN unset it assumes dry-run,
# so a fleet start reports what it "would" launch and launches nothing. That is
# the right default for a library that something else might import by accident,
# and the wrong one here -- typing `runfleet-cli start` is an explicit request
# to run. So opt in, but only if the caller has not said otherwise, which keeps
# `SOTN_CMD_DRYRUN=1 runfleet-cli start` usable as a preview.
#
# This is why the fleet buttons appeared to do nothing: they succeeded, in
# dry-run, and said so in a dict nobody reads closely.
export SOTN_CMD_DRYRUN="${SOTN_CMD_DRYRUN:-0}"

CMD="$(basename "$0")"
VERB="${1:-}"
shift || true

# Every command resolves the repo from its OWN location via readlink -f, then
# cds there. That is what makes them work from any directory: you never have to
# be in the repo, and $PWD is never consulted. The only thing installation adds
# is putting the names on PATH.
COMMANDS=(run-permuter runfleet runfleet-cli runfleet-llama sotn-dash)
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

install_cmds() {
    local bindir="${1:-$HOME/.local/bin}"
    mkdir -p "$bindir"
    local n
    for n in "${COMMANDS[@]}"; do
        ln -sfn "$SELF" "$bindir/$n"
        echo "  $bindir/$n -> $SELF"
    done
    echo
    case ":$PATH:" in
        *":$bindir:"*)
            echo "$bindir is already on PATH. Open a new shell or run:"
            echo "  hash -r"
            echo "Then '${COMMANDS[0]} plan' works from anywhere."
            ;;
        *)
            local line="export PATH=\"$bindir:\$PATH\""
            echo "$bindir is NOT on PATH yet. Add it:"
            echo "  echo '$line' >> ~/.bashrc && exec bash"
            echo
            echo "Or re-run with --add-path to append that line for you."
            ;;
    esac
}

uninstall_cmds() {
    local bindir="${1:-$HOME/.local/bin}"
    local n
    for n in "${COMMANDS[@]}"; do
        # Only remove a symlink that points at THIS script. Refusing to touch
        # anything else means a name collision with some other tool of the same
        # name cannot be silently deleted by an uninstall.
        if [ -L "$bindir/$n" ] && [ "$(readlink -f "$bindir/$n")" = "$SELF" ]; then
            rm -f "$bindir/$n"
            echo "  removed $bindir/$n"
        elif [ -e "$bindir/$n" ]; then
            echo "  SKIPPED $bindir/$n (not our symlink; left alone)"
        fi
    done
}

usage() {
    cat <<'EOF'
SOTN harness process control.

  run-permuter    start|stop|status|plan   supervised permuter over the queue
  runfleet        start|stop|status        zen worker fleet -- USE THIS ONE
  runfleet-llama  start|stop|status        local llama worker fleet
  runfleet-cli    start|stop|status        OpenCode CLI fleet; see below
  sotn-dash       start|stop|status        localhost dashboard

`runfleet` is the default backend. `runfleet-cli` reaches the SAME free Zen
models through `opencode run`, which relays only `content` while these models
fill `reasoning_content` first: it comes back empty most of the time, and more
often the larger the function. Use it only to test the CLI path itself.

Defaults are the measured ones; override with flags after the verb.

  run-permuter start --slots 3 --threads 4
  runfleet start 2                # or: --workers 2
  sotn-dash start --port 8777

`plan` and `status` never start or stop anything, so they are always safe.
EOF
}

need_verb() {
    # sotn-run under its real name is the installer and has its own verbs, so
    # it is exempt from the start/stop/status/plan set.
    [ "$CMD" = "sotn-run" ] && return 0
    case "$VERB" in
        start|stop|status|plan) : ;;
        ""|-h|--help|help) usage; exit 0 ;;
        *) echo "unknown verb '$VERB' for $CMD" >&2; usage >&2; exit 2 ;;
    esac
}

# Fleet control goes through commands_client so it shares ONE definition of
# what a fleet is with the MCP connector. A second launcher here would drift
# from that one, and the drift would only show up as workers nobody can stop.
fleet() {
    local backend="$1"; shift
    # Accept BOTH `runfleet-cli start 2` and `runfleet-cli start --workers 2`.
    # The usage text documented the flag form while the code only took the
    # positional, so the documented command failed with "workers must be a
    # number". Taking both is cheaper than picking one and being wrong again.
    local workers=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --workers) workers="${2:-}"; shift 2 ;;
            --workers=*) workers="${1#*=}"; shift ;;
            "") shift ;;
            *) workers="$1"; shift ;;
        esac
    done
    case "$VERB" in
        start)
            local n="${workers:-2}"
            [[ "$n" =~ ^[0-9]+$ ]] || { echo "workers must be a number, got '$n'" >&2; exit 2; }
            "$PY" - "$backend" "$n" <<'PY'
import sys
sys.path.insert(0, "automation/mcp")
import commands_client as cc
backend, n = sys.argv[1], int(sys.argv[2])
print(cc.fleet_start(workers=n, backend=backend))
PY
            ;;
        stop)
            # hold=True reclaims the workers' queue records. A killed worker
            # cannot release its own claim, so skipping this leaves records
            # stuck in 'claimed' and invisible to every later run.
            "$PY" -c "
import sys; sys.path.insert(0,'automation/mcp')
import commands_client as cc; print(cc.fleet_stop(hold=True))"
            ;;
        status)
            "$PY" -c "
import sys, json; sys.path.insert(0,'automation/mcp')
import commands_client as cc; print(json.dumps(cc.fleet_status(tail=3), indent=2))"
            ;;
        plan) echo "plan is only meaningful for run-permuter" >&2; exit 2 ;;
    esac
}

need_verb

case "$CMD" in
    run-permuter)
        case "$VERB" in
            start)  exec "$PY" automation/permuter_supervisor.py --run --mode legacy "$@" ;;
            plan)   exec "$PY" automation/permuter_supervisor.py --plan "$@" ;;
            stop)   exec "$PY" automation/permuter_supervisor.py --stop ;;
            status) exec "$PY" automation/permuter_supervisor.py --status ;;
        esac
        ;;
    runfleet)       fleet zen   "$@" ;;
    runfleet-cli)   fleet cli   "$@" ;;
    # WAS `fleet http`, WHICH STARTED A ZEN FLEET. `http` is a legacy alias
    # that fleet_start resolves to `zen` (commands_client, "Legacy alias"), so
    # the one command named after llama was the one command that could not
    # launch llama, and `runfleet-zen` did not exist so there was no way to ask
    # for zen by name either. Both spellings now say what they do.
    runfleet-llama) fleet llama "$@" ;;
    sotn-dash)
        case "$VERB" in
            start)  exec "$PY" automation/dashboard.py --serve "$@" ;;
            stop)   exec "$PY" automation/dashboard.py --stop ;;
            status) exec "$PY" automation/dashboard.py --status ;;
            plan)   echo "plan is only meaningful for run-permuter" >&2; exit 2 ;;
        esac
        ;;
    sotn-run)
        # Invoked by its real name: the installer entry point. This is the one
        # command you run with a full path, exactly once.
        case "$VERB" in
            install)
                bindir="$HOME/.local/bin"
                add_path=0
                while [ $# -gt 0 ]; do
                    case "$1" in
                        --bindir) bindir="$2"; shift 2 ;;
                        --add-path) add_path=1; shift ;;
                        *) echo "unknown option '$1'" >&2; exit 2 ;;
                    esac
                done
                echo "installing SOTN commands into $bindir"
                install_cmds "$bindir"
                if [ "$add_path" = 1 ]; then
                    line="export PATH=\"$bindir:\$PATH\""
                    if grep -qxF "$line" "$HOME/.bashrc" 2>/dev/null; then
                        echo "~/.bashrc already has that line; not adding it twice"
                    else
                        printf '\n# SOTN harness commands\n%s\n' "$line" >> "$HOME/.bashrc"
                        echo "appended to ~/.bashrc; run: exec bash"
                    fi
                fi
                ;;
            uninstall)
                bindir="${1:-$HOME/.local/bin}"   # VERB was already shifted off
                echo "removing SOTN commands from $bindir"
                uninstall_cmds "$bindir"
                ;;
            *)
                cat <<EOF
sotn-run is the installer for the SOTN harness commands.

  sotn-run install [--bindir DIR] [--add-path]
  sotn-run uninstall [DIR]

Default DIR is ~/.local/bin. After installing, these work from ANY directory:

  ${COMMANDS[*]}
EOF
                [ "$VERB" = "" ] && exit 0 || exit 2
                ;;
        esac
        ;;
    *)
        echo "unknown command name '$CMD'" >&2
        echo "run 'sotn-run install' to create the command symlinks" >&2
        exit 2
        ;;
esac
