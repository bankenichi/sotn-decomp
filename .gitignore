# Matches globally
ctx.c
ctx.c.m2c
# Per-worker m2ctx output. m2ctx.py writes ONE hardcoded ctx.c, so every
# fleet worker raced on it; each worker now gets ctx.<WORKER_NAME>.c. The
# two exact names above did not cover those, and 38k lines of generated
# context were committed on 2026-08-02 before anyone noticed.
ctx.*.c
ctx.*.c.m2c
sotn_calltree.txt
__pycache__
.idea/
.venv/
asm/
build/
release/
expected/
rpt/
disks/
nonmatchings/
.vscode/settings.json

# Splat-generated asset headers: src/<overlay>/gen/, holding g_GfxEquipIcon.h,
# g_saveIcon*.h, D_800C*.h and hash-suffixed duplicates of the same. Build
# output that happens to land under src/, so it was never covered by build/.
#
# Not cosmetic. permuter_supervisor's require_clean_src refuses to land or
# attribute anything while src/ differs from HEAD -- correctly, because the
# usual cause is a candidate left applied by a run killed mid-apply. These 17
# untracked directories triggered exactly that refusal and blocked --land,
# while being nothing but generated data.
src/**/gen/

# Unsure if these are directories or files
function_calls
gmon.out

# Temporary files that are used during make format-src and make format-symbols respectively
format-src.run
format-symbols.run

# Matches in repo root folder only
/*.map
/assets/

# ninja stuff
.ninja_lock
.ninja_log
.ninja_deps
build.ninja
build.ninja.version

# objdiff stuff
objdiff*.json

# rust
target/**

# in-game generated recording files
recordings/
# Generated by tools/saturn-splitter from config/saturn/*.yaml
/config/saturn/*.ld
automation/logs/

# Machine-specific companion to ORCHESTRATOR.md: absolute paths, usernames,
# local endpoints. Never commit. See ORCHESTRATOR.md section 0.
ORCHESTRATOR.local.md
